# Public web application
DEPLOYMENT_ENV=development
NEXT_PUBLIC_APP_URL=https://lms.example.com

# Clerk Authentication (development instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Supabase Project (shared PrepZii database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# Walkthrough alerts through your SMTP server
DEMO_REQUEST_SMTP_HOST=
DEMO_REQUEST_SMTP_PORT=587
DEMO_REQUEST_SMTP_USER=
DEMO_REQUEST_SMTP_PASSWORD=
DEMO_REQUEST_FROM_EMAIL=
DEMO_REQUEST_TO_EMAIL=contact@prepzii.com

# Security & Invitations (min 32 characters)
INVITATION_TOKEN_SECRET=your_invitation_token_secret
ALLOW_INSECURE_DEV_AUTH=false

# AI Model Configuration
GEMINI_API_KEY=your_gemini_api_key
ZI_AI_MODEL=gemini-3.5-flash

# Payment Mode (Razorpay deferred until final integration phase per directive)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=
PLATFORM_ADMIN_USER_IDS=

# =====================================================================
# PREPZII B2B LMS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.production (or set in Vercel / Railway / AWS / Docker)
# =====================================================================

# 1. APPLICATION ENVIRONMENT
DEPLOYMENT_ENV=production
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://lms.yourdomain.com

# 2. CLERK AUTHENTICATION (LIVE PRODUCTION INSTANCE)
# Important: In production, publishable key must start with pk_live_
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_live_YOUR_LIVE_CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# 3. SUPABASE (SHARED PREPZII BACKEND)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_jwt_token_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# PostgreSQL direct connection URL (used for migrations and admin tasks)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# 4. SECURITY & FAIL-CLOSED GUARDS
# INVITATION_TOKEN_SECRET must be a high-entropy string of at least 32 characters
INVITATION_TOKEN_SECRET=replace-with-a-random-32-plus-character-secret-key-for-tokens
# Development bypass MUST remain false in production
ALLOW_INSECURE_DEV_AUTH=false

# 5. PLATFORM ADMINISTRATION
# Comma-separated list of Clerk user IDs authorized for platform admin / superadmin routes
PLATFORM_ADMIN_USER_IDS=

# 6. AI SUITE (GEMINI)
GEMINI_API_KEY=your_gemini_api_key_here
ZI_AI_MODEL=gemini-2.5-flash

# 7. PAYMENT GATEWAY (DEFERRED - Integrate when ready to accept online payments)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# FASTAPI_INTERNAL_URL=
# INTERNAL_API_KEY=

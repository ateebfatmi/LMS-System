{
  "name": "prepzii-b2b",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant learning management system for schools and coaching institutes.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @prepzii-b2b/web",
    "build": "npm run build --workspace @prepzii-b2b/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "./scripts/run_database_tests.sh",
    "test:e2e": "playwright test",
    "test:e2e:staging": "playwright test --config=playwright.staging.config.ts",
    "test:load": "node scripts/load-smoke.mjs",
    "test:restore": "./scripts/verify-backup-restore.sh",
    "audit:migrations": "node scripts/audit-migration-history.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:sql": "python3 scripts/test-sql-schema-integration.py",
    "validate:env": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/validate-production-env.ts",
    "db:bundle": "node scripts/build-migration-bundle.mjs",
    "db:deploy": "bash scripts/apply-remote-migrations.sh",
    "preflight": "tsc scripts/check-backend-compatibility.ts --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck --outDir scripts/dist && node --env-file-if-exists=apps/web/.env.local --env-file-if-exists=.env.local scripts/dist/check-backend-compatibility.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1"
  }
}

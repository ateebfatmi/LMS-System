{
  "name": "prepzii-b2b",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant learning management system for schools and coaching institutes.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @prepzii-b2b/web",
    "build": "npm run build --workspace @prepzii-b2b/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}


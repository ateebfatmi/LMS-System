# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Use the SAME Clerk instance and keys as consumer Prepzii.
# User IDs must resolve to the existing institutes/institute_members records.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Use the SAME Supabase project as consumer Prepzii.
# Never point this app at a second B2B-only database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

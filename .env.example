# Public web application
DEPLOYMENT_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Same Clerk instance used by consumer PrepZii
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local development only. Never enable in staging or production. When true,
# x-authenticated-user may stand in for a Clerk session for local API testing.
ALLOW_INSECURE_DEV_AUTH=false

# Same Supabase project used by consumer PrepZii
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Server-controlled Clerk user allowlist for /super-admin
PLATFORM_SUPER_ADMIN_USER_IDS=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional internal FastAPI prototype. Browsers must never receive the key.
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=
INVITATION_TOKEN_SECRET=

# Shared PrepZii Gemini provider (server-only). AI outputs remain drafts until reviewed.
GEMINI_API_KEY=
ZI_AI_MODEL=gemini-2.5-flash

# Public web application
DEPLOYMENT_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Clerk Authentication (development instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/resolve
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/resolve

# Supabase Project (shared PrepZii database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Walkthrough alerts through your SMTP server
DEMO_REQUEST_SMTP_HOST=
DEMO_REQUEST_SMTP_PORT=587
DEMO_REQUEST_SMTP_USER=
DEMO_REQUEST_SMTP_PASSWORD=
DEMO_REQUEST_FROM_EMAIL=

# Security & Invitations (min 32 characters)
INVITATION_TOKEN_SECRET=
ALLOW_INSECURE_DEV_AUTH=false

# AI Model Configuration
GEMINI_API_KEY=
ZI_AI_MODEL=gemini-3.5-flash

# Payment Mode (Razorpay deferred until final integration phase per directive)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
PLATFORM_SUPER_ADMIN_USER_IDS=
